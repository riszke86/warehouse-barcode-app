<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title><%= pageTitle %></title>

    <link rel="stylesheet" href="/css/styles.css">
</head>

<body>

    <div class="app-layout">

        <!-- ================= SIDEBAR ================= -->

        <aside class="sidebar">

            <div class="brand">
                <div class="brand-icon">
                    W
                </div>

                <div>
                    <h2>Warehouse</h2>
                    <p>Inventory System</p>
                </div>
            </div>

            <nav class="sidebar-nav">

                <a href="/" class="nav-link">
                    <span class="nav-icon">⌂</span>
                    Dashboard
                </a>

                <a href="/inventory" class="nav-link">
                    <span class="nav-icon">▦</span>
                    Inventory
                </a>

                <a href="/products/create" class="nav-link active">
                    <span class="nav-icon">＋</span>
                    Create Product
                </a>

                <a href="/products/barcode-generator" class="nav-link">
                    <span class="nav-icon">▥</span>
                    Quick Barcode
                </a>

                <a href="/scanner" class="nav-link">
                    <span class="nav-icon">▥</span>
                    Barcode Scanner
                </a>

            </nav>

            <div class="sidebar-footer">
                <p>Warehouse Barcode App</p>
                <span>Version 1.0</span>
            </div>

        </aside>


        <!-- ================= MAIN AREA ================= -->

        <div class="main-area">

            <!-- TOP BAR -->

            <header class="topbar">

                <div>
                    <p class="topbar-label">
                        Product Management
                    </p>

                    <h1>Create Product</h1>
                </div>

                <a href="/inventory" class="secondary-button">
                    View Inventory
                </a>

            </header>


            <!-- PAGE CONTENT -->

            <main class="page-content">

                <section class="page-intro">

                    <div class="intro-icon">
                        +
                    </div>

                    <div>
                        <h2>Add a new warehouse product</h2>

                        <p>
                            Enter the product details below. A unique barcode
                            will be generated after the product is saved.
                        </p>
                    </div>

                </section>


                <!-- CREATE PRODUCT FORM -->

                <section class="form-card">

                    <div class="card-heading">

                        <div>
                            <p class="section-label">
                                Product information
                            </p>

                            <h2>Product details</h2>
                        </div>

                        <span class="required-note">
                            * Required fields
                        </span>

                    </div>

                    <% if (errorMessage) { %>

                        <div class="error-message">
                            <strong>Product not created</strong>
                            <p><%= errorMessage %></p>
                        </div>

                    <% } %>


                    <form
                        class="product-form"
                        action="/products/create"
                        method="POST"
                    >

                        <div class="form-grid">

                            <!-- PRODUCT NAME -->

                            <div class="form-group form-group-full">

                                <label for="productName">
                                    Product name
                                    <span>*</span>
                                </label>

                                <input
                                    type="text"
                                    id="productName"
                                    name="productName"
                                    placeholder="Example: Wireless Keyboard"
                                    value="<%= formData.productName || '' %>"
                                    required
                                >

                                <small>
                                    Enter the full product name.
                                </small>

                            </div>


                            <!-- SKU -->

                            <div class="form-group">

                                <label for="sku">
                                    SKU
                                    <span>*</span>
                                </label>

                                <input
                                    type="text"
                                    id="sku"
                                    name="sku"
                                    placeholder="Example: KEY-001"
                                    value="<%= formData.sku || '' %>"
                                    required
                                >

                                <small>
                                    Use a unique stock-keeping code.
                                </small>

                            </div>


                            <!-- CATEGORY -->

                            <div class="form-group">

                                <label for="category">
                                    Category
                                    <span>*</span>
                                </label>

                                <select
                                    id="category"
                                    name="category"
                                    required
                                >
                                    <option
                                        value=""
                                        <%= !formData.category ? "selected" : "" %>
                                    >
                                        Select category
                                    </option>

                                    <option
                                        value="Electronics"
                                        <%= formData.category === "Electronics" ? "selected" : "" %>
                                    >
                                        Electronics
                                    </option>

                                    <option
                                        value="Clothing"
                                        <%= formData.category === "Clothing" ? "selected" : "" %>
                                    >
                                        Clothing
                                    </option>

                                    <option
                                        value="Food and Drink"
                                        <%= formData.category === "Food and Drink" ? "selected" : "" %>
                                    >
                                        Food and Drink
                                    </option>

                                    <option
                                        value="Home and Garden"
                                        <%= formData.category === "Home and Garden" ? "selected" : "" %>
                                    >
                                        Home and Garden
                                    </option>

                                    <option
                                        value="Office Supplies"
                                        <%= formData.category === "Office Supplies" ? "selected" : "" %>
                                    >
                                        Office Supplies
                                    </option>

                                    <option
                                        value="Other"
                                        <%= formData.category === "Other" ? "selected" : "" %>
                                    >
                                        Other
                                    </option>
                                </select>

                                <small>
                                    Choose the closest product category.
                                </small>

                            </div>


                            <!-- LOCATION -->

                            <div class="form-group">

                                <label for="location">
                                    Warehouse location
                                    <span>*</span>
                                </label>

                                <input
                                    type="text"
                                    id="location"
                                    name="location"
                                    placeholder="Example: A-03-15"
                                    value="<%= formData.location || '' %>"
                                    required
                                >

                                <small>
                                    Aisle, rack and shelf location.
                                </small>

                            </div>


                            <!-- QUANTITY -->

                            <div class="form-group">

                                <label for="quantity">
                                    Opening quantity
                                    <span>*</span>
                                </label>

                                <input
                                    type="number"
                                    id="quantity"
                                    name="quantity"
                                    value="<%= formData.quantity ?? 1 %>"
                                    min="0"
                                    required
                                >

                                <small>
                                    Current quantity available in stock.
                                </small>

                            </div>

                        </div>


                        <!-- FORM ACTIONS -->

                        <div class="form-actions">

                            <a href="/" class="cancel-button">
                                Cancel
                            </a>

                            <button type="submit" class="primary-button">
                                <span>＋</span>
                                Create Product
                            </button>

                        </div>

                    </form>

                </section>


                <!-- INFORMATION CARD -->

                <section class="information-card">

                    <div class="information-icon">
                        i
                    </div>

                    <div>
                        <h3>Automatic barcode generation</h3>

                        <p>
                            After the product is created, the system will
                            generate a unique barcode linked to the product
                            record.
                        </p>
                    </div>

                </section>

            </main>

        </div>

    </div>

</body>

</html>